<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Kauf laeuft per IPC ueber die Play-Store-App (BILLING bleibt). INTERNET und ACCESS_NETWORK_STATE
         kommen nur aus datatransport (Protokoll der Billing-Library an Google) und werden entfernt: die App geht nie ins Internet. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
</manifest>
