<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">dozr</string>
    <string name="tagline">A sleep timer for every app. Music, podcasts or videos fade out gently and stop, and your volume is back where it was.</string>
    <string name="note_how">Drag the moon up to set the time. While it runs, the moon slowly sets. At the end dozr lowers the media volume along the curve, asks other players to pause and then restores your volume. If you change the volume yourself while it fades, dozr leaves it alone.</string>

