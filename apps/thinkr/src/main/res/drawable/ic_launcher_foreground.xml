                android:centerY="57"
                android:gradientRadius="20"
                android:startColor="#80F27BE8"
                android:endColor="#00F27BE8" />
        </aapt:attr>
    </path>
    <!-- kleine Sterne -->
    <path
        android:fillColor="#FFFBE3F8"
        android:pathData="M30.8,66a4.2,4.2 0 1,0 8.4,0a4.2,4.2 0 1,0 -8.4,0zM45.8,41a4.2,4.2 0 1,0 8.4,0a4.2,4.2 0 1,0 -8.4,0z" />
    <!-- Funke -->
    <path android:pathData="M64.5,57a7.5,7.5 0 1,0 15,0a7.5,7.5 0 1,0 -15,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="70.5"
                android:centerY="54.5"
                android:gradientRadius="9"
                android:startColor="#FFFFFFFF"
                android:endColor="#FFF27BE8" />
        </aapt:attr>
