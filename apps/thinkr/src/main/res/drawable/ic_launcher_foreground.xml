<?xml version="1.0" encoding="utf-8"?>
<!-- Mini-Sternbild: zwei kleine Punkte, ein grosser leuchtender Funke, zwei Linien -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Lichthof gesamt -->
    <path android:pathData="M20,54a34,34 0 1,0 68,0a34,34 0 1,0 -68,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="56"
                android:centerY="54"
                android:gradientRadius="34"
                android:startColor="#2EF27BE8"
                android:endColor="#00F27BE8" />
